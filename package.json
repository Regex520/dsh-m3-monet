{
  "name": "@local/dsh-m3-monet",
  "version": "0.1.0",
  "private": true,
  "description": "Monet wallpaper theming for DeepSeek Harness: Material Design 3 tokens, frosted glass sidebar, wallpaper background.",
  "license": "MIT",
  "author": "Regex520",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Regex520/dsh-m3-monet.git"
  },
  "homepage": "https://github.com/Regex520/dsh-m3-monet#readme",
  "bugs": {
    "url": "https://github.com/Regex520/dsh-m3-monet/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "material-design-3",
    "monet",
    "dynamic-color",
    "theming",
    "wallpaper"
  ],
  "type": "module",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
